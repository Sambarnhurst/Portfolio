{
  "name": "heaven-cloud-mesh-staging",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {"name": "MESH_ROOMS", "class_name": "MeshRoom"}
    ]
  },
  "exports": {
    "MeshRoom": {"type": "durable-object", "storage": "sqlite"}
  },
  "vars": {"MESH_ENABLED": "false"}
}
