{
  "name": "portfolio",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/dev", "/dev/*"]
  },
  "routes": [
    {
      "pattern": "projectheaven.site/*",
      "zone_name": "projectheaven.site"
    }
  ]
}
